{
  "name": "8086-lab-debug",
  "displayName": "8086 Lab: MASM/TASM Debugger",
  "description": "8086 source debugger with bundled JavaScript/WASM runtime; follows MASM/TASM selections. No Python setup.",
  "version": "0.5.0",
  "publisher": "newplayerxu",
  "license": "SEE LICENSE IN LICENSE",
  "preview": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Debuggers",
    "Education"
  ],
  "keywords": [
    "8086",
    "masm",
    "tasm",
    "assembly",
    "registers",
    "real-mode"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "xsro.masm-tasm"
  ],
  "activationEvents": [
    "onDebugResolve:8086-lab"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Building runs a DOS assembler in an emulator; trust the workspace first."
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "Web entry supports virtual files through the VS Code file-system API; desktop builds still require local files."
    }
  },
  "scripts": {
    "check": "node scripts/check.js && node --check src/extension.js && node --check src/adapter.js && node --check src/core.js && node --check src/compiler.js && node --check src/source.js && node --check src/expression.js",
    "test:js": "node --test test/*.test.js",
    "test": "npm run check && npm run test:js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm test && npm run build:web",
    "build:web": "node scripts/build-web.js",
    "test:web:runtime": "node scripts/test-web-runtime.cjs",
    "test:web:host": "node scripts/test-web-host.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.0.0",
    "buffer": "6.0.3",
    "esbuild": "0.25.11",
    "fflate": "0.8.3",
    "path-browserify": "1.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "8086lab.setup",
        "title": "8086 Lab: Check Bundled Runtime"
      },
      {
        "command": "8086lab.check",
        "title": "8086 Lab: Check Environment"
      },
      {
        "command": "8086lab.chooseDosbox",
        "title": "8086 Lab: Select DOSBox-X Executable"
      },
      {
        "command": "8086lab.debugFile",
        "title": "8086 Lab: Debug Current ASM File"
      },
      {
        "command": "8086lab.openSample",
        "title": "8086 Lab: Open Register Tutorial"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "8086lab.debugFile",
          "when": "resourceExtname == .asm",
          "group": "8086lab"
        }
      ]
    },
    "configuration": {
      "title": "8086 Lab",
      "properties": {
        "8086lab.pythonPath": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Ignored since 0.4.0: the JavaScript/WASM runtime is bundled. Remove this legacy Python setting."
        },
        "8086lab.runtimePythonPath": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Ignored since 0.4.0: the JavaScript/WASM runtime is bundled. Remove this legacy Python setting."
        },
        "8086lab.dosboxPath": {
          "type": "string",
          "default": "",
          "description": "Optional DOSBox-X executable override when MASM/TASM selects dosbox-x. jsdos/jsdos-x use the dependency runtime and need no external DOSBox executable."
        },
        "8086lab.tasmDirectory": {
          "type": "string",
          "default": "",
          "description": "Optional TASM/TLINK directory when TASM is selected. Clear it to follow MASM built-in compiler bundles."
        },
        "8086lab.buildDirectory": {
          "type": "string",
          "default": "",
          "description": "Optional temporary build root. jsdos/jsdos-x support Unicode paths; external DOSBox builds require an ASCII path. Each session gets its own subdirectory."
        }
      }
    },
    "breakpoints": [
      {
        "language": "assembly"
      }
    ],
    "debuggers": [
      {
        "type": "8086-lab",
        "label": "8086 Lab (MASM/TASM)",
        "languages": [
          "assembly"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Single-file 16-bit MASM/TASM source.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              },
              "maxInstructions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000,
                "default": 1000000,
                "description": "Maximum instructions per continue before pausing."
              },
              "sourceEncoding": {
                "type": "string",
                "enum": [
                  "utf-8-sig",
                  "gbk",
                  "cp437"
                ],
                "default": "utf-8-sig"
              },
              "dosboxPath": {
                "type": "string",
                "description": "Override DOSBox-X executable for this launch."
              },
              "tasmDirectory": {
                "type": "string",
                "description": "Override TASM/TLINK directory for this launch."
              },
              "programFormat": {
                "type": "string",
                "enum": [
                  "auto",
                  "exe",
                  "com"
                ],
                "default": "auto",
                "description": "Detect tiny/ORG 100H COM sources automatically, or force DOS EXE/COM loading."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "8086 Lab: Debug current ASM",
            "type": "8086-lab",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "8086 Lab: MASM/TASM",
            "description": "Debug an ASM source with registers and flags.",
            "body": {
              "name": "8086 Lab: Debug current ASM",
              "type": "8086-lab",
              "request": "launch",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/newplayerXu/8086-lab-debug.git"
  },
  "homepage": "https://github.com/newplayerXu/8086-lab-debug#readme",
  "bugs": {
    "url": "https://github.com/newplayerXu/8086-lab-debug/issues"
  },
  "icon": "assets/icon.png",
  "dependencies": {
    "@alexaltea/unicorn-js": "2.1.4",
    "adm-zip": "0.6.1",
    "iced-x86": "1.21.0",
    "iconv-lite": "0.7.2"
  },
  "browser": "./dist/web/extension.js"
}
